# Server Port (assigned dynamically by cloud host like Render, or 5000 in dev)
PORT=5000

# Environment: 'development' or 'production' (MUST be 'production' in deployment to disable Demo Login)
NODE_ENV=development

# MongoDB Connection String (Atlas SRV URI in production)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kirana_db?retryWrites=true&w=majority

# JWT Signing Secret (generate a strong random secret for production)
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Client Origin for CORS and Cookies (e.g. https://your-app.vercel.app in production)
CLIENT_ORIGIN=http://localhost:5802

# Seeded Platform Admin Credentials (change in production)
ADMIN_USER_ID=admin
ADMIN_PASSWORD=admin123
