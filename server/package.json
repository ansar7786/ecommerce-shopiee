{
  "name": "kirana-platform-server",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:catalogue": "node seed/seedCatalogue.js",
    "seed:images": "node seed/fetchImages.js",
    "seed:stores": "node seed/seedStores.js",
    "seed:demo": "node seed/seedDemo.js",
    "seed:all": "node seed/seedCatalogue.js && node seed/seedStores.js && node seed/seedDemo.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^7.3.1"
  }
}
