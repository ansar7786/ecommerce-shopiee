{
  "name": "kirana-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed:catalogue": "npm --prefix server run seed:catalogue",
    "seed:images": "npm --prefix server run seed:images",
    "seed:stores": "npm --prefix server run seed:stores",
    "seed:demo": "npm --prefix server run seed:demo",
    "seed:all": "npm --prefix server run seed:all",
    "lint": "npm --prefix server run lint && npm --prefix client run lint",
    "format": "npm --prefix server run format && npm --prefix client run format",
    "test": "npm --prefix server test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
